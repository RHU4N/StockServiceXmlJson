              "pm.test(\"Vary: Accept\", () => pm.expect(pm.response.headers.get(\"Vary\") || \"\").to.match(/\\bAccept\\b/i));",
              "pm.test(\"Coleção XML\", () => { const p = xml2Json(pm.response.text()).produtos.produto; pm.expect(p).to.be.an(\"array\").with.lengthOf.at.least(5); });"
