          }
        ],
        "url": {
          "raw": "{{baseUrl}}/produtos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "1"
          ]
        },
        "description": "Salva dados e tamanho para comparação com a próxima requisição."
      },
