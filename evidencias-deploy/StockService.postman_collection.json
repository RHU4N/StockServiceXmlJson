    {
      "name": "04 - Consultar Notebook | XML e comparar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: application/xml\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/xml\"));",
              "pm.test(\"Vary: Accept\", () => pm.expect(pm.response.headers.get(\"Vary\") || \"\").to.match(/\\bAccept\\b/i));",
              "pm.test(\"Dados do Notebook\", () => { const p = xml2Json(pm.response.text()).produto; pm.expect(Number(p.id)).to.eql(1); pm.expect(p.nome).to.eql(\"Notebook\"); pm.expect(Number(p.preco)).to.eql(2500); pm.expect(Number(p.estoque)).to.eql(12); });",
              "pm.test(\"Equivalência com JSON da requisição 03\", () => { const anterior = pm.collectionVariables.get(\"produtoJson\"); pm.expect(anterior, \"Execute a requisição 03 antes\").to.be.ok; const p = xml2Json(pm.response.text()).produto; pm.expect({id:Number(p.id),nome:p.nome,preco:Number(p.preco),estoque:Number(p.estoque)}).to.deep.eql(JSON.parse(anterior)); });",
              "console.log(\"JSON (bytes UTF-8):\", pm.collectionVariables.get(\"jsonBytes\"), \"XML (bytes UTF-8):\", unescape(encodeURIComponent(pm.response.text())).length);"
            ]
          }
        }
      ],
