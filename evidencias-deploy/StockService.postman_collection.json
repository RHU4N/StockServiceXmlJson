      "name": "06 - Cadastrar produto | JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Content-Type: application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Vary: Accept\", () => pm.expect(pm.response.headers.get(\"Vary\") || \"\").to.match(/\\bAccept\\b/i));",
              "pm.test(\"Produto cadastrado\", () => { const p = pm.response.json(); pm.expect(p.id).to.be.a(\"number\"); pm.expect(p.nome).to.eql(\"Webcam HD\"); pm.expect(p.preco).to.eql(249.9); pm.expect(p.estoque).to.eql(10); });",
              "if(pm.response.code===201) pm.collectionVariables.set(\"idCriadoJson\",String(pm.response.json().id));"
            ]
          }
