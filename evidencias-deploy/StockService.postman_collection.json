    {
      "name": "03 - Consultar Notebook | JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Vary: Accept\", () => pm.expect(pm.response.headers.get(\"Vary\") || \"\").to.match(/\\bAccept\\b/i));",
              "pm.test(\"Dados do Notebook\", () => { const p = pm.response.json(); pm.expect(p.id).to.eql(1); pm.expect(p.nome).to.eql(\"Notebook\"); pm.expect(p.preco).to.eql(2500); pm.expect(p.estoque).to.eql(12); });",
              "if (pm.response.code === 200) { const p = pm.response.json(); pm.collectionVariables.set(\"produtoJson\", JSON.stringify({id:p.id,nome:p.nome,preco:p.preco,estoque:p.estoque})); pm.collectionVariables.set(\"jsonBytes\", unescape(encodeURIComponent(pm.response.text())).length.toString()); }"
            ]
          }
        }
      ],
      "id": "7698925c-4f5c-49b6-938a-5d74c224ca39",
      "request": {
        "method": "GET",
