    {
      "name": "01 - Listar produtos | JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Vary: Accept\", () => pm.expect(pm.response.headers.get(\"Vary\") || \"\").to.match(/\\bAccept\\b/i));",
              "pm.test(\"Coleção de produtos\", () => pm.expect(pm.response.json().produtos).to.be.an(\"array\").with.lengthOf.at.least(5));"
            ]
          }
        }
      ],
      "id": "7a2d84ac-9ea5-4500-912f-1f36ae026fea",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        },
        "description": "Lista em JSON. A raiz contém a propriedade produtos."
      },
      "response": [],
      "createdAt": "2026-11-26T07:34:21.000Z",
